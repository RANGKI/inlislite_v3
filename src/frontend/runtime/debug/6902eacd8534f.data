;a:5:{i:0;s:69:"SELECT * FROM v_stat_jumlah_koleksi WHERE tahun = 2024 and bulan = 10";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1761798862.12431;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:672;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:178;a:5:{i:0;s:69:"SELECT * FROM v_stat_jumlah_koleksi WHERE tahun = 2024 and bulan = 10";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1761798862.13115;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:672;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:180;a:5:{i:0;s:763:" SELECT 
                    YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                    MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `colit`.`Collection_id`) AS `jumlah_eksemplar`
                    FROM
                    `collectionloanitems` `colit`
                    WHERE
                    (`colit`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 2024
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 10
                    GROUP BY YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d'))
                ";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1761798862.1313219;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:695;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:181;a:5:{i:0;s:763:" SELECT 
                    YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                    MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `colit`.`Collection_id`) AS `jumlah_eksemplar`
                    FROM
                    `collectionloanitems` `colit`
                    WHERE
                    (`colit`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 2024
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 10
                    GROUP BY YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d'))
                ";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1761798862.1316659;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:695;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:183;a:5:{i:0;s:854:" SELECT 
                    YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
