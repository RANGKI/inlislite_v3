;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:672;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:179;a:5:{i:0;s:763:" SELECT 
                    YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                    MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `colit`.`Collection_id`) AS `jumlah_eksemplar`
                    FROM
                    `collectionloanitems` `colit`
                    WHERE
                    (`colit`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 2024
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 10
                    GROUP BY YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d'))
                ";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761799484.4228411;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:695;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:182;a:5:{i:0;s:854:" SELECT 
                    YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                    MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `cole`.`Catalog_id`) AS `jumlah_judul`
                    FROM
                    `collectionloanitems` `colit`
                    INNER JOIN `collections` `cole` ON `colit`.`Collection_id` = `cole`.`ID`
                    WHERE
                    (`colit`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) =  2024
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) =  10
                    GROUP BY YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d'))
                    ";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761799484.4236989;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:714;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:185;a:5:{i:0;s:792:"  SELECT 
                        YEAR(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                        MONTH(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                        COUNT(DISTINCT `baca`.`collection_id`) AS `jumlah_eksemplar`
                        FROM
                        `bacaditempat` `baca`
                        WHERE
                          (`baca`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                         AND YEAR(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) = 2024
                         AND MONTH(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) = 10
                        GROUP BY YEAR(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d'))
                ";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761799484.4245291;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:737;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:188;a:5:{i:0;s:841:"  SELECT 
                    YEAR(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                    MONTH(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `cole`.`Catalog_id`) AS `jumlah_judul`
                    FROM
                    `bacaditempat` `baca`
                    INNER JOIN `collections` `cole` ON `baca`.`collection_id` = `cole`.`ID`
                    WHERE
                      (`baca`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                     AND YEAR(STR_TO_DATE(`baca`.`CreateDate`, '%Y-%m-%d')) = 2024
