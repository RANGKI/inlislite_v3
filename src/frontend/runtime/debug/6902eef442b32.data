                    MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `colit`.`Collection_id`) AS `jumlah_eksemplar`
                    FROM
                    `collectionloanitems` `colit`
                    WHERE
