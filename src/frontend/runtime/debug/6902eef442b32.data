                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 2025
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 04
                    GROUP BY YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d'))
