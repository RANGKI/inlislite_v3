                    (`colit`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) =  2024
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) =  10
