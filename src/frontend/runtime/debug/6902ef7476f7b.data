    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'v_pertumb_jml_kunjungan_bulanan' AND kcu.table_name = 'v_pertumb_jml_kunjungan_bulanan'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761800053.0393569;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:659;s:8:"function";s:3:"one";s:5:"class";s:18:"yii\db\ActiveQuery";s:4:"type";s:2:"->";}}}i:179;a:5:{i:0;s:118:"SELECT * FROM `v_pertumb_jml_kunjungan_bulanan` WHERE (`kriteria`='ROMBONGAN') AND (`tahun`='2024') AND (`bulan`='10')";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761800053.041043;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:662;s:8:"function";s:3:"one";s:5:"class";s:18:"yii\db\ActiveQuery";s:4:"type";s:2:"->";}}}i:182;a:5:{i:0;s:69:"SELECT * FROM v_stat_jumlah_koleksi WHERE tahun = 2024 and bulan = 10";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761800053.0593939;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:672;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:185;a:5:{i:0;s:763:" SELECT 
                    YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `tahun`,
                    MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) AS `bulan`,
                    COUNT(DISTINCT `colit`.`Collection_id`) AS `jumlah_eksemplar`
                    FROM
                    `collectionloanitems` `colit`
                    WHERE
                    (`colit`.`CreateDate` BETWEEN ('2024-10-01') AND ('2025-09-30'))
                    AND YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 2024
                    AND MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) = 10
                    GROUP BY YEAR(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d')) , MONTH(STR_TO_DATE(`colit`.`CreateDate`, '%Y-%m-%d'))
                ";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761800053.0784931;i:4;a:1:{i:0;a:5:{s:4:"file";s:95:"C:\xampp\htdocs\inlislite3\frontend\controllers\StatistikPerkembanganPerpustakaanController.php";s:4:"line";i:695;s:8:"function";s:8:"queryOne";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:188;a:5:{i:0;s:854:" SELECT 
