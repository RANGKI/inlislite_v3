 site/index";i:1;i:8;i:2;s:30:"yii\base\Controller::runAction";i:3;d:1761798852.0162101;i:4;a:0:{}}i:23;a:5:{i:0;s:62:"Running action: opac\controllers\SiteController::actionIndex()";i:1;i:8;i:2;s:36:"yii\base\InlineAction::runWithParams";i:3;d:1761798852.018734;i:4;a:0:{}}i:24;a:5:{i:0;s:43:"SELECT Name, Value FROM `settingparameters`";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761798852.5429909;i:4;a:3:{i:0;a:5:{s:4:"file";s:55:"C:\xampp\htdocs\inlislite3\common\components\Config.php";s:4:"line";i:117;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:55:"C:\xampp\htdocs\inlislite3\common\components\Config.php";s:4:"line";i:99;s:8:"function";s:14:"_getDataFromDb";s:5:"class";s:24:"common\components\Config";s:4:"type";s:2:"->";}i:2;a:5:{s:4:"file";s:55:"C:\xampp\htdocs\inlislite3\common\components\Config.php";s:4:"line";i:158;s:8:"function";s:7:"getData";s:5:"class";s:24:"common\components\Config";s:4:"type";s:2:"->";}}}i:27;a:5:{i:0;s:524:"
          SELECT   c.title AS title, c.id AS catalog_id, c.author AS author,
           c.publishyear AS YEAR, 
          TRIM(c.coverurl) AS coverurl, w.Name worksheet_name, w.ID Worksheet_id  
        
           FROM collections s 
          INNER JOIN catalogs c ON c.id = s.catalog_id 
          LEFT JOIN worksheets w ON w.ID = c.Worksheet_id          
           
          WHERE c.ISOPAC =1 and s.ISOPAC =1
          GROUP BY c.id 
          Order by  s.TanggalPengadaan desc,c.ID desc
          LIMIT 0,8;
        ";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761798852.5496099;i:4;a:1:{i:0;a:5:{s:4:"file";s:62:"C:\xampp\htdocs\inlislite3\opac\controllers\SiteController.php";s:4:"line";i:148;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:30;a:5:{i:0;s:589:" 
          SELECT  COUNT(collection_id) jumlah, c.title AS title, c.id AS catalog_id, c.author AS author,
           c.publishyear AS YEAR, 
          TRIM(c.coverurl) AS coverurl, w.Name worksheet_name, w.ID Worksheet_id
          
           FROM collectionloanitems h 
          INNER JOIN collections s ON s.id = h.collection_id 
          INNER JOIN catalogs c ON c.id = s.catalog_id
          LEFT JOIN worksheets w ON w.ID = c.Worksheet_id 
          
          WHERE c.ISOPAC =1 and s.ISOPAC =1
          GROUP BY c.id 
          ORDER BY jumlah DESC
          LIMIT 0,8;
        ";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1761798852.5514901;i:4;a:1:{i:0;a:5:{s:4:"file";s:62:"C:\xampp\htdocs\inlislite3\opac\controllers\SiteController.php";s:4:"line";i:150;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:33;a:5:{i:0;s:505:" 
          SELECT c.title AS title, c.id AS catalog_id, c.author AS author,
           c.publishyear AS YEAR, 
          TRIM(c.coverurl) AS coverurl,
          w.Name worksheet_name, w.ID Worksheet_id 
          FROM kriteria_koleksi k 
          left join catalogs c on k.catalog_id = c.ID  
          LEFT JOIN worksheets w ON w.ID = c.Worksheet_id 
          
          where k.jns_kriteria='koleksi_unggul'  
          and c.ISOPAC =1 
          GROUP BY k.ID 
          ORDER BY k.ID DESC 
