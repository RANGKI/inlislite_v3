          LEFT JOIN worksheets w ON w.ID = c.Worksheet_id          
           
          WHERE c.ISOPAC =1 and s.ISOPAC =1
          GROUP BY c.id 
          Order by  s.TanggalPengadaan desc,c.ID desc
          LIMIT 0,8;
        ";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1761798852.5513439;i:4;a:1:{i:0;a:5:{s:4:"file";s:62:"C:\xampp\htdocs\inlislite3\opac\controllers\SiteController.php";s:4:"line";i:148;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:31;a:5:{i:0;s:589:" 
          SELECT  COUNT(collection_id) jumlah, c.title AS title, c.id AS catalog_id, c.author AS author,
           c.publishyear AS YEAR, 
          TRIM(c.coverurl) AS coverurl, w.Name worksheet_name, w.ID Worksheet_id
          
           FROM collectionloanitems h 
          INNER JOIN collections s ON s.id = h.collection_id 
          INNER JOIN catalogs c ON c.id = s.catalog_id
          LEFT JOIN worksheets w ON w.ID = c.Worksheet_id 
          
          WHERE c.ISOPAC =1 and s.ISOPAC =1
          GROUP BY c.id 
          ORDER BY jumlah DESC
          LIMIT 0,8;
        ";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1761798852.5515349;i:4;a:1:{i:0;a:5:{s:4:"file";s:62:"C:\xampp\htdocs\inlislite3\opac\controllers\SiteController.php";s:4:"line";i:150;s:8:"function";s:8:"queryAll";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}}}i:32;a:5:{i:0;s:589:" 
